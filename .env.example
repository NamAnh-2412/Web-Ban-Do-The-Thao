APP_NAME=WebTheThao
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/WebTheThao/public

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webthethao
DB_USERNAME=root
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

PAYMENT_BANK_NAME=Vietcombank
PAYMENT_BANK_ACCOUNT=0123456789
PAYMENT_BANK_HOLDER=WEBTHETHAO
PAYMENT_BANK_CONTENT_PREFIX=WTT

MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_VERIFY_SSL=false
# MOMO_REDIRECT_URL=
# MOMO_IPN_URL=

GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=
GHN_VERIFY_SSL=false
GHN_FROM_DISTRICT_ID=
GHN_FROM_WARD_CODE=
GHN_FROM_NAME=WebTheThao
GHN_FROM_PHONE=0900000000
GHN_FROM_ADDRESS=
GHN_DEFAULT_WEIGHT=200

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mặc định: ghi log. Muốn nhận mail Gmail: xem docs/XAC_THUC_EMAIL.md
# Đơn đã nhận, nhắc trả đồ, quá hạn và quên mật khẩu dùng cùng bộ MAIL_* này.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

NOTIFICATION_DUE_REMINDER_DAYS=1

# Chỉ điền trên Render. Máy XAMPP để trống. Mật khẩu admin production không ghi vào git.
# TRUSTED_PROXIES=
# RUN_MIGRATIONS=true
# RUN_SEEDERS=false
# SEED_ADMIN_NAME=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Ảnh sản phẩm trên Render. Để trống thì máy local lưu vào storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=webthethao/products

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
